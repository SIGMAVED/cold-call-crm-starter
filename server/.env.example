# Copy to .env. Easiest path: fill in just TWILIO_ACCOUNT_SID and
# TWILIO_AUTH_TOKEN, then run `node setup-twilio.js` — it creates the API
# Key + TwiML App and fills in the rest of the TWILIO_* values for you.
# See SETUP.md at the repo root for the full walkthrough.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Filled in automatically by setup-twilio.js (or manually from the Console):
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=

DEEPGRAM_API_KEY=

# Your ngrok/tunnel https URL, e.g. https://xxxx.ngrok-free.app (no trailing slash)
PUBLIC_BASE_URL=

# ---- Call recording ----
# Outbound calls are recorded by default (dual-channel: you and the prospect on
# separate tracks). Twilio stores the audio and serves it as MP3 — the CRM shows
# a player on the lead. Set to false to disable. Requires PUBLIC_BASE_URL.
RECORD_CALLS=true

# Recorded-call disclosure. If set, the prospect hears this the moment they
# answer, before being connected to you. Leave BLANK to play nothing.
# Note: several US states (Florida and California among them) require ALL
# parties to consent to a recording — check the two-party-consent laws for
# wherever your leads actually are. If you aren't disclosing verbally
# yourself, set this.
# Example: This call is recorded for quality and training purposes.
RECORDING_DISCLOSURE=

# ---- Follow-up email drafting ----
# Powers the "Draft Follow-up Email" button on a lead: sends its call
# transcript + notes to Gemini and gets back a draft you review before
# sending — nothing is ever emailed automatically. Get a key at
# https://aistudio.google.com/app/apikey (free tier is plenty for this).
GEMINI_API_KEY=

# Your name and the demo/callback number your email drafts should push
# prospects to call — both get baked directly into the AI-drafted email copy
# (server/routes/leads.js). Defaults to placeholders if left blank.
REP_NAME=
DEMO_PHONE_NUMBER=
